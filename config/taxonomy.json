 "_state_patterns_readme": "Optional regex overrides per state. Default is the state name as a whole word, so 'Niger' never matches 'Nigeria'.",
 "state_patterns": {
  "Nasarawa": "\\bnas+arawa\\b",
  "Niger": "\\bniger\\b(?!\\s+(republic|delta))(?!\\s*\\()",
  "FCT": "\\bfct\\b|\\babuja\\b|federal capital territory",
  "Akwa Ibom": "\\bakwa[\\s-]*ibom\\b",
  "Cross River": "\\bcross[\\s-]*river\\b",
  "Delta": "(?<!niger\\s)\\bdelta\\b(?!\\s+(region|area))",
  "Rivers": "\\brivers\\s+state\\b|\\brivers\\s*(,|and\\b|&)|(,|and|&)\\s*rivers\\b"
 },
 "year_min": 2015,
 "year_max": 2030,
 "_scope_readme": "Only pages whose TITLE matches this pattern are counted (DTM Nigeria products are titled 'Nigeria — …'). Set to empty to count everything found.",
 "scope_title_regex": "^\\s*(dtm\\s+)?nig[eé]ria\\b",
 "mobility_tracking_rounds": {
  "_readme": "Expected Mobility Tracking rounds per region, used for the round-coverage check.",
  "NE": 52,
  "NCNW": 19
 },
 "needs_monitoring_rounds": {
  "_readme": "Round ranges whose main round report is always counted as Needs Monitoring (DTM Nigeria rule). Other rounds are decided from the PDF file name / PDF text.",
  "NE": [
   1,
   40
  ],
  "NCNW": [
   1,
   9
  ]
 }
