{
  "_readme": "Edit these keyword lists to tune classification. Rules are checked top to bottom against the report TITLE first, then the summary; the first matching rule wins. Matching is case-insensitive. 'exclude' blocks a rule if any of its terms appear.",
  "components": [
    {"key": "ewer", "label": "Early Warning & Early Response Dashboard",
     "include": ["early warning dashboard", "early warning & early response", "early warning and early response", "ewer", "alert tool"], "exclude": []},
    {"key": "ett", "label": "Emergency Tracking Tool (ETT)",
     "include": ["emergency tracking tool", " ett ", "ett report"], "exclude": []},
    {"key": "flash", "label": "Incident / Flash Report",
     "include": ["flash report", "flash rep", "incident report", "flash update", "incident update"], "exclude": []},
    {"key": "flood", "label": "Post-Flood Situation Report (Ad-Hoc)",
     "include": ["post-flood", "post flood", "flood situation report", "flood situation", "flood assessment", "flood report"], "exclude": []},
    {"key": "biometric", "label": "Biometric Registration Report",
     "include": ["biometric", "bio-metric", "registration report"], "exclude": []},
    {"key": "intention", "label": "Intention Surveys",
     "include": ["intention survey", "intentions survey", "return intention", "intentions of idps"], "exclude": []},
    {"key": "smi", "label": "Solutions Mobility Index / Stability Index",
     "include": ["solutions mobility index", "solution mobility index", "stability index", "mobility index", "durable solutions index"], "exclude": []},
    {"key": "ses_fm", "label": "Socio-Economic Survey & Facility Mapping",
     "include": ["facility mapping", "facilities mapping", "service mapping", "infrastructure mapping", "village assessment"], "exclude": []},
    {"key": "ses", "label": "Socio Economic Survey",
     "include": ["socio-economic survey", "socio economic survey", "socioeconomic survey", "socio-economic", "livelihood survey"], "exclude": []},
    {"key": "needs", "label": "Mobility Tracking – Needs Monitoring",
     "include": ["needs monitoring", "nm round", "multi-sectoral needs", "multisectoral needs"], "exclude": []},
    {"key": "transhumance", "label": "Transhumance Flow Monitoring Report",
     "include": ["transhumance", "flow monitoring"], "exclude": ["early warning"]},
    {"key": "atlas", "label": "Mobility Tracking – IDP & Returnee Atlas",
     "include": ["atlas", "mobility tracking", "displacement report", "baseline assessment", "site assessment", "location assessment", "master list", "idp and returnee", "idps and returnees"], "exclude": []}
  ],
  "unclassified_key": "other",
  "unclassified_label": "Other / Unclassified",
  "regions": {
    "North East": {
      "aliases": ["north-east", "north east", "northeast"],
      "states": ["Adamawa", "Borno", "Yobe", "Gombe", "Taraba", "Bauchi"]
    },
    "North Central": {
      "aliases": ["north-central", "north central", "northcentral", "ncnw"],
      "states": ["Benue", "Nasarawa", "Plateau", "Kogi", "Niger"]
    },
    "North West": {
      "aliases": ["north-west", "north west", "northwest", "ncnw"],
      "states": ["Kano", "Kaduna", "Katsina", "Sokoto", "Zamfara"]
    }
  },
  "_state_patterns_readme": "Optional regex overrides per state. Default is the state name as a whole word, so 'Niger' never matches 'Nigeria'.",
  "state_patterns": {
    "Nasarawa": "\\bnas+arawa\\b",
    "Niger": "\\bniger\\b(?!\\s+republic)"
  },
  "year_min": 2019,
  "year_max": 2030
}
